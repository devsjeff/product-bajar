# Application
APP_NAME=ProductBajar
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=productbajar
POSTGRES_USER=productbajar
POSTGRES_PASSWORD=productbajar_secret
DATABASE_URL=postgresql+asyncpg://productbajar:productbajar_secret@db:5432/productbajar

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# File Storage (S3 or local)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/app/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@productbajar.com

# Geo defaults (India)
DEFAULT_SEARCH_RADIUS_KM=10
MAX_SEARCH_RADIUS_KM=100

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
